BOT_TOKEN=replace_with_token_from_BotFather
DATABASE_URL=postgresql+asyncpg://bot_user:change_me@localhost:5432/love_bot
# Положительные числовые ID личных аккаунтов, через запятую или JSON-массив.
ADMIN_IDS=123456789,987654321
AUTO_APPROVE_ENABLED=false
# Резерв для будущего проверенного классификатора; правила не выдают вероятность.
AUTO_APPROVE_CONFIDENCE=0.95
MAX_SUBMISSIONS_PER_HOUR=3
MAX_TEXT_LENGTH=500
LOG_LEVEL=INFO
DUPLICATE_WINDOW_HOURS=24
DRAFT_TTL_SECONDS=1800
RETENTION_DAYS=180
ORIGINAL_TEXT_RETENTION_DAYS=7
TECHNICAL_RETENTION_DAYS=7
DISPLAY_TIMEZONE=Europe/Moscow
# Добавьте бота в администраторы канала с правом публикации сообщений.
CHANNEL_ID=
PUBLICATION_ENABLED=false
PUBLICATION_INTERVAL_SECONDS=60
