[Unit]
Description=VGSPU anonymous submissions Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lovebot
Group=lovebot
WorkingDirectory=/opt/love-bot
EnvironmentFile=/opt/love-bot/.env
ExecStartPre=/opt/love-bot/.venv/bin/alembic upgrade head
ExecStart=/opt/love-bot/.venv/bin/python -m love_bot
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
